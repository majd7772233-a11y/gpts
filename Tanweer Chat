    data class Synced<T>(val value: T) : MutationResult<T>()
    data class Pending<T>(
        val value: T,
        val message: String
    ) : MutationResult<T>()

    data class Failed(
        val message: String
    ) : MutationResult<Nothing>()
}
ثم الـUI يعرف الحقيقة:

when (val result = viewModel.addHomework(...)) {
    is MutationResult.Synced -> {
        // ✅ نشر فعلي
    }

    is MutationResult.Pending -> {
        // 🟡 محلي الآن
    }

    is MutationResult.Failed -> {
        // ❌ فشل
    }
}
